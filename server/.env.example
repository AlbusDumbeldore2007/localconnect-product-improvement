# LocalConnect Backend Environment Configuration

# Server Port (default 5000)
PORT=5000

# PostgreSQL Database URL
# Example for Hosted Neon PostgreSQL:
# DATABASE_URL="postgresql://neondb_owner:password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Example for Supabase:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
# Example for Local Docker / PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/localconnect"
DATABASE_URL=
